{
  "kind": "collectionType",
  "collectionName": "catalog_collections",
  "info": {
    "singularName": "catalog-collection",
    "pluralName": "catalog-collections",
    "displayName": "Подборка товаров"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "sortOrder": {
      "type": "integer"
    },
    "selectionMode": {
      "type": "enumeration",
      "enum": [
        "manual",
        "category",
        "discount",
        "new"
      ]
    },
    "noveltyDays": {
      "type": "integer",
      "default": 100,
      "min": 1
    },
    "noveltyBadgeColor": {
      "type": "string",
      "default": "#2eae4a"
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::moysklad-product.moysklad-product",
      "inversedBy": "catalog_collections"
    },
    "sourceCategory": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::moysklad-category.moysklad-category"
    }
  },
  "config": {
    "metadatas": {
      "selectionMode": {
        "edit": {
          "label": "Режим подборки",
          "description": "Выберите, откуда брать товары: вручную, из категории, со скидкой или из новинок."
        }
      },
      "noveltyDays": {
        "edit": {
          "label": "Период новинок на сайте",
          "description": "Укажите срок в днях. Например: 100."
        }
      },
      "noveltyBadgeColor": {
        "edit": {
          "label": "Цвет бейджа «Новинка»",
          "description": "Укажите HEX-код. Например: #2EAE4A."
        }
      },
      "products": {
        "edit": {
          "label": "Товары",
          "description": "Добавьте товары вручную."
        }
      },
      "sourceCategory": {
        "edit": {
          "label": "Категория",
          "description": "Выберите категорию-источник."
        }
      }
    }
  }
}
